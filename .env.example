# Cloudflare DNS + Pages automation (used by scripts/cloudflareSetup.mjs)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ROOT_DOMAIN=pondbridgealumni.com

# Actual API host from your backend provider (Render/Fly/etc), not api.pondbridgealumni.com.
# Example: pondbridge-api.onrender.com
CLOUDFLARE_API_ORIGIN=

# Frontend CNAME target.
# For Cloudflare Pages this is typically: <your-pages-project>.pages.dev
CLOUDFLARE_WEB_CNAME_TARGET=

# Record names under CLOUDFLARE_ROOT_DOMAIN
CLOUDFLARE_API_RECORD_NAME=api
CLOUDFLARE_WEB_RECORD_NAME=app
CLOUDFLARE_WILDCARD_RECORD_NAME=*

# DNS behavior
CLOUDFLARE_PROXIED=true
CLOUDFLARE_API_PROXIED=false
CLOUDFLARE_WEB_PROXIED=true
CLOUDFLARE_TTL=1
CLOUDFLARE_CREATE_WILDCARD=true
CLOUDFLARE_CREATE_APEX=true
CLOUDFLARE_CREATE_WWW=true

# Optional: also bind custom domains to a Pages project via Cloudflare API
CLOUDFLARE_BIND_PAGES_DOMAINS=false
CLOUDFLARE_PAGES_PROJECT_NAME=

# Optional convenience values for app deployment environments
# (API reads these in apps/api/.env, web reads VITE_* in apps/web/.env)
AUTH_PROVIDER=legacy
CLERK_SECRET_KEY=
CLERK_SUPER_ADMIN_EMAILS=
STRIPE_PRICE_LEGACY_ANNUAL=
STRIPE_PRICE_FOUNDERS_ANNUAL=
STRIPE_PRICE_INSTITUTIONAL_ANNUAL=
STRIPE_PRICE_LEGACY_ONBOARDING=
STRIPE_PRICE_INSTITUTIONAL_ONBOARDING=
ALLOW_MOCK_BILLING_IN_PRODUCTION=false
EMAIL_MODE=mock
EMAIL_FROM=no-reply@pondbridgealumni.com
RESEND_API_KEY=
RESEND_REQUEST_TIMEOUT_MS=12000
RESEND_MAX_RETRIES=2
RESEND_RETRY_BASE_DELAY_MS=300
EMAIL_BROADCAST_BATCH_SIZE=40
EMAIL_BROADCAST_MAX_RECIPIENTS=500
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_MAX_UPLOAD_BYTES=20971520
R2_PRESIGN_EXPIRES_SECONDS=900
R2_DEFAULT_CACHE_CONTROL=public, max-age=31536000, immutable
VITE_AUTH_PROVIDER=legacy
VITE_CLERK_PUBLISHABLE_KEY=
