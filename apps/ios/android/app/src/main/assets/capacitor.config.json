{
	"appId": "com.pondbridge.ios",
	"appName": "PondBridge",
	"webDir": "../web/dist",
	"bundledWebRuntime": false,
	"server": {
		"url": "https://app.pondbridgealumni.com",
		"iosScheme": "https"
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"StatusBar": {
			"overlaysWebView": false,
			"style": "LIGHT",
			"backgroundColor": "#002b5c"
		}
	}
}
