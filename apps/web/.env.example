VITE_API_BASE=http://localhost:4000
VITE_NATIVE_API_BASE=https://api.pondbridgealumni.com
VITE_APP_BASE_DOMAIN=pondbridgealumni.com
VITE_AUTH_PROVIDER=legacy
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_AFTER_SIGN_IN_URL=/auth/callback
VITE_CLERK_AFTER_SIGN_UP_URL=/auth/callback
