{
  "name": "@pondbridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "lint": "eslint src scripts",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test jest --runInBand",
    "test:with-reset": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_ENV=test PONDBRIDGE_ALLOW_DB_RESET=1 PONDBRIDGE_TEST_RESET_ACK=1 jest --runInBand",
    "seed": "node scripts/seed.js",
    "seed:demo": "node scripts/seedDemoCamp.js",
    "seed:demo:reset": "node scripts/seedDemoCamp.js --reset",
    "demo:create": "node scripts/createDemoCamp.js",
    "seed:camp-profiles": "node scripts/seedCampProfiles.js",
    "dev:provision-test-camp": "node scripts/devProvisionTestCampFlow.js",
    "supabase:apply-schema": "node scripts/applySupabaseSchema.js",
    "rls:audit": "node scripts/rlsCoverageReport.js",
    "db:preflight": "node scripts/dbPreflightCheck.js",
    "supabase:harden-users-uniqueness": "node scripts/hardenUsersUniqueness.js",
    "migrate:legacy-media-to-r2": "node scripts/migrateLegacyMediaToR2.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@clerk/backend": "^2.32.0",
    "@pondbridge/shared": "0.1.0",
    "@supabase/supabase-js": "^2.97.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "openai": "^5.15.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.18.0",
    "sanitize-html": "^2.17.1",
    "socket.io": "^4.8.3",
    "stripe": "^18.4.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.0"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "scripts"
    ],
    "ext": "js,json"
  }
}
