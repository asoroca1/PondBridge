PORT=4000
AUTH_PROVIDER=legacy
HYBRID_ALLOW_LEGACY_TOKENS=true
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
APP_BASE_DOMAIN=pondbridgealumni.com
TENANT_HOST_SUFFIXES=pondbridgealumni.com
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
PUBLIC_API_ORIGIN=http://localhost:4000
CORS_ALLOW_SUBDOMAIN_ORIGINS=true
CUSTOM_DOMAIN_ALLOWLIST=
TRUST_PROXY_HOPS=1
OPENAI_API_KEY=
# Off by default. Example opt-in: {"director_copilot_v1":["pilot-camp"]}
FEATURE_FLAGS={}
OPENAI_DIRECTOR_COPILOT_MODEL=gpt-5.6-luna
OPENAI_DIRECTOR_COPILOT_MAX_OUTPUT_TOKENS=900
OPENAI_DIRECTOR_COPILOT_TIMEOUT_MS=30000
# Off-by-default Communications Agent uses the durable tenant rollout key
# director_email_agent_v1. Every request is draft-only and cost-metered.
OPENAI_EMAIL_AGENT_MODEL=gpt-5.6-luna
OPENAI_EMAIL_AGENT_MAX_OUTPUT_TOKENS=1800
OPENAI_EMAIL_AGENT_TIMEOUT_MS=30000
EMAIL_AGENT_MONTHLY_BUDGET_USD=25
# Off-by-default member search planner. The model receives only the member's
# query and generic camp role labels; directory records stay inside PondBridge.
OPENAI_SEARCH_MODEL=gpt-5.6-luna
OPENAI_SEARCH_MAX_OUTPUT_TOKENS=500
OPENAI_SEARCH_TIMEOUT_MS=20000
AI_SEARCH_MONTHLY_BUDGET_USD=15
# Premium resume and LinkedIn Save-to-PDF extraction. Uploaded files and raw
# extracted text are not retained; AI usage is metered per camp.
OPENAI_PROFILE_IMPORT_MODEL=gpt-5.6-luna
OPENAI_PROFILE_IMPORT_MAX_OUTPUT_TOKENS=1600
OPENAI_PROFILE_IMPORT_TIMEOUT_MS=30000
PROFILE_IMPORT_MONTHLY_BUDGET_USD=15
# Cross-camp operations assistant. Keep false until platform-agent evals pass.
SUPER_COPILOT_ENABLED=false
OPENAI_SUPER_COPILOT_MODEL=gpt-5.6-terra
OPENAI_SUPER_COPILOT_MAX_OUTPUT_TOKENS=1100
OPENAI_SUPER_COPILOT_TIMEOUT_MS=30000
# Global super-admin outreach workspace. Chat is durable and approval-first;
# enabling web research allows public web results to be processed by OpenAI.
OUTREACH_AGENT_ENABLED=false
OUTREACH_WEB_RESEARCH_ENABLED=false
OPENAI_OUTREACH_MODEL=gpt-5.6-terra
OPENAI_OUTREACH_MAX_OUTPUT_TOKENS=1600
OPENAI_OUTREACH_TIMEOUT_MS=35000
BILLING_MODE=auto
ALLOW_MOCK_BILLING_IN_PRODUCTION=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Canonical annual subscription prices
STRIPE_PRICE_FLAGSHIP_ANNUAL=
STRIPE_PRICE_TEST_ANNUAL=
# Canonical one-time onboarding fee prices
# Backward-compatible aliases (optional)
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_BILLING_PORTAL_RETURN_URL=
STRIPE_CURRENCY=usd
MOCK_BILLING_BASE_URL=https://mock-billing.pondbridge.local
EMAIL_MODE=mock
EMAIL_FROM=no-reply@pondbridgealumni.com
RESEND_API_KEY=
RESEND_API_BASE_URL=https://api.resend.com
RESEND_WEBHOOK_SECRET=
RESEND_WEBHOOK_TOLERANCE_SECONDS=300
RESEND_USER_AGENT=pondbridge-api/1.0
RESEND_REQUEST_TIMEOUT_MS=12000
RESEND_MAX_RETRIES=2
RESEND_RETRY_BASE_DELAY_MS=300
RESEND_BATCH_ENABLED=true
EMAIL_SUPPRESSION_ENABLED=true
# Use a dedicated long random secret in staging/production. JWT_SECRET is a
# compatibility fallback, but rotating either secret invalidates old links.
EMAIL_PREFERENCE_TOKEN_SECRET=
EMAIL_BROADCAST_BATCH_SIZE=40
EMAIL_BROADCAST_MAX_RECIPIENTS=500
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PAGES_PROJECT_NAME=
CLOUDFLARE_WEB_CNAME_TARGET=
CLOUDFLARE_WEB_PROXIED=true
CLOUDFLARE_TTL=1
CLOUDFLARE_DOMAIN_READY_TIMEOUT_MS=25000
CLOUDFLARE_DOMAIN_READY_POLL_MS=1200
SUPER_TENANT_HARD_DELETE_ENABLED=false
SUPER_TENANT_PRODUCTION_WIPE_ENABLED=false
SUPER_TENANT_DEMO_RESET_ENABLED=false
SUPER_TENANT_DELETION_GRACE_HOURS=24
R2_BUCKET_NAME=pondbridge-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_MAX_UPLOAD_BYTES=20971520
R2_PRESIGN_EXPIRES_SECONDS=900
R2_DEFAULT_CACHE_CONTROL=public, max-age=31536000, immutable
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.pondbridge.ios
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=true
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
FCM_ANDROID_APP_ID=com.pondbridge.android
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
INVITE_EXPIRES_DAYS=7
MAGIC_LINK_EXPIRES_MINUTES=20
AUTH_TOKEN_MODE=hybrid
AUTH_COOKIE_NAME=pondbridge_auth
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_MAX_AGE_SECONDS=604800
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_AUTHORIZED_PARTIES=
CLERK_JWT_AUDIENCE=
CLERK_REQUIRE_TENANT_CLAIM=false
CLERK_SUPER_ADMIN_EMAILS=
CLERK_SUPER_ADMIN_USER_IDS=
CLERK_BOOTSTRAP_FIRST_SUPER_ADMIN=true
ALLOW_PUBLIC_AUTO_BOOTSTRAP_FIRST_TENANT=0
ALLOW_EMPTY_PRODUCTION_TENANTS=0
PRODUCTION_MIN_TENANTS=1
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
PONDBRIDGE_TARGET_ENV=local
PONDBRIDGE_SCHEMA_APPLY_ACK=
PONDBRIDGE_MULTI_CAMP_BACKFILL_ACK=
PONDBRIDGE_FRESH_CAMP_REHEARSAL_ACK=
PONDBRIDGE_ALLOW_DB_RESET=0
PONDBRIDGE_TEST_RESET_ACK=0
PONDBRIDGE_TEST_DB_MARKERS=localhost,127.0.0.1
PONDBRIDGE_DISABLE_DB_MARKER_GUARD=0
PONDBRIDGE_CONFIRM_WIPE_EXISTING_TENANTS=0
PONDBRIDGE_ALLOW_PROD_SEED=0
PONDBRIDGE_SEED_DELETE_LEGACY_DEMO=0
