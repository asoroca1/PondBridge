# Hosted staging environment (Supabase project "PondBridge Staging").
#
# Copy to .env.staging and fill in the secrets. .env.staging is gitignored.
# Never put production values in this file -- see docs/REMOTE_STAGING.md.

# --- Supabase (staging project, NOT production) ---
STAGING_SUPABASE_PROJECT_REF=pvmabzjotcpvdpffsrgp
SUPABASE_URL=https://pvmabzjotcpvdpffsrgp.supabase.co

# Service role key: dashboard -> Project Settings -> API keys
SUPABASE_SERVICE_ROLE_KEY=

# Database password: dashboard -> Project Settings -> Database -> Reset password.
# Required by scripts/remoteStaging.mjs to run `supabase db push`.
STAGING_SUPABASE_DB_PASSWORD=

# --- App ---
NODE_ENV=development
AUTH_PROVIDER=legacy
JWT_SECRET=staging-only-change-me
AUTH_TOKEN_MODE=bearer
AUTH_COOKIE_SAMESITE=lax

# Staging must never send real email, charge a real card, or push a real notification.
EMAIL_MODE=mock
BILLING_MODE=mock
ALLOW_MOCK_BILLING_IN_PRODUCTION=false

# Leave third-party keys empty so staging cannot reach live providers.
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
CLERK_SECRET_KEY=
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
APNS_PRIVATE_KEY=

# --- Web ---
VITE_AUTH_PROVIDER=legacy
VITE_CLERK_PUBLISHABLE_KEY=
