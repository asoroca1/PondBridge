{
  "name": "pondbridge-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @pondbridge/api run dev",
    "dev:web": "npm --workspace @pondbridge/web run dev",
    "ios:build": "npm --workspace @pondbridge/ios run build:web",
    "ios:sync": "npm --workspace @pondbridge/ios run sync",
    "ios:open": "npm --workspace @pondbridge/ios run open",
    "ios:doctor": "npm --workspace @pondbridge/ios run doctor",
    "cloudflare:setup": "node scripts/cloudflareSetup.mjs",
    "cloudflare:setup:dry": "node scripts/cloudflareSetup.mjs --dry-run",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "perf:check-web": "node scripts/checkWebBuildBudget.mjs",
    "smoke:spa-routing": "node scripts/smokeSpaRouting.mjs",
    "db:preflight": "npm --workspace @pondbridge/api run db:preflight",
    "format": "prettier --write .",
    "security:check-env": "node scripts/checkTrackedEnv.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.23.0",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^16.0.0",
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.1",
    "clsx": "^2.1.1",
    "colord": "^2.9.3",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.575.0",
    "react-hook-form": "^7.71.2",
    "zod": "^4.3.6"
  }
}
